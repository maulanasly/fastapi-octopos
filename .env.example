# FastAPI OctoPOS environment configuration
# Copy to .env and update the values before running.

ENVIRONMENT=development

# CORS — set explicit origins in production (e.g. ["https://yourapp.com"])
BACKEND_CORS_ORIGINS=["http://localhost:3001", "http://localhost:8080"]

# Optional regex of extra origins. Use this for dev clients on ephemeral
# ports (e.g. `flutter run -d chrome`):
BACKEND_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:[0-9]+)?

# Database — SQLite (default) or PostgreSQL:
#   SQLite:    sqlite:///./sql_app.db
#   PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5433/octopos
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://postgres:postgres@localhost:5433/octopos

# Security — change in production
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Google Auth (optional)
GOOGLE_CLIENT_ID=

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SESSION_HOURS=12

# Order reservation
ORDER_RESERVATION_TIMEOUT_MINUTES=15
RESERVATION_AUTO_EXPIRE_ENABLED=False
RESERVATION_AUTO_EXPIRE_INTERVAL_SECONDS=300

# Tax (migration-seeded default rule)
DEFAULT_TAX_RATE=0.0
DEFAULT_TAX_NAME=VAT

# Login lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Product images
MEDIA_DIR=media

# Auto purchase orders
REPLENISHMENT_AUTO_PO_ENABLED=False
REPLENISHMENT_CHECK_INTERVAL_SECONDS=3600
REPLENISHMENT_LOOKBACK_DAYS=30

# Logging
LOG_LEVEL=INFO
LOG_JSON=False
