# Production environment for the bare-metal VPS deployment.
# bootstrap.sh generates /etc/octopos/octopos.env with real secrets; this file
# documents every variable the service expects. The unit reads it via
# EnvironmentFile, so values are plain KEY=VALUE (no quotes needed).

ENVIRONMENT=production

# Comma/JSON list of allowed browser origins (Flutter web / admin panel).
BACKEND_CORS_ORIGINS=["https://your-frontend.example.com"]

# Optional regex for extra origins.
# BACKEND_CORS_ORIGIN_REGEX=

# PostgreSQL — bootstrap.sh writes the generated password here.
SQLALCHEMY_DATABASE_URI=postgresql+psycopg://octopos:CHANGE-ME@localhost:5432/octopos

# JWT signing — bootstrap.sh generates 32 random bytes.
SECRET_KEY=CHANGE-ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# Admin panel (/admin) credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME
ADMIN_SESSION_HOURS=12

# Google Sign-In (optional).
GOOGLE_CLIENT_ID=

# Shared rate-limit storage — required with WEB_CONCURRENCY > 1 so limits
# apply across granian workers.
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# Stock reservation sweep (enable in production when reservations are used).
ORDER_RESERVATION_TIMEOUT_MINUTES=15
RESERVATION_AUTO_EXPIRE_ENABLED=True
RESERVATION_AUTO_EXPIRE_INTERVAL_SECONDS=300

# Migration-seeded default tax rule.
DEFAULT_TAX_RATE=0.0
DEFAULT_TAX_NAME=VAT

# Login lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Product image uploads (persistent dir created by bootstrap.sh).
MEDIA_DIR=/var/lib/octopos/media

# Scheduled auto purchase orders (optional).
REPLENISHMENT_AUTO_PO_ENABLED=False
REPLENISHMENT_CHECK_INTERVAL_SECONDS=3600
REPLENISHMENT_LOOKBACK_DAYS=30

# Semantic search embeddings: hash = offline default; api = OpenAI-compatible.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=all-minilm
EMBEDDING_DIM=384
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Logging.
LOG_LEVEL=INFO
LOG_JSON=True

# granian worker count (2 fits a 2 CPU / 2 GB VPS shared with postgres).
WEB_CONCURRENCY=2
